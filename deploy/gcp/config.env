# GCP deployment settings. Any value can be overridden with an environment variable.
PROJECT_ID=${PROJECT_ID:-payments-settlement-platform}
REGION=${REGION:-us-east4}                 # Northern Virginia, close to the Fed's East Coast operations
SERVICE=${SERVICE:-paysettle}
REPO=${REPO:-paysettle}
TAG=${TAG:-v1}
SQL_INSTANCE=${SQL_INSTANCE:-paysettle-pg}
# db-f1-micro: cheapest shared-core tier (~$10/month). Use a dedicated-core tier with HA for real traffic.
SQL_TIER=${SQL_TIER:-db-f1-micro}
DB_NAME=${DB_NAME:-paysettle}
DB_USER=${DB_USER:-paysettle}

# DEMO_MODE=true enables the demo traffic generator (/api/v1/simulator/**). Payments always go to the
# simulated FedACH and Fedwire gateways in this project; there is no live network connection.
DEMO_MODE=${DEMO_MODE:-true}
# Set to an OIDC issuer (Google, Okta, Entra ID, Ping) to require SSO bearer tokens instead of API keys.
# Tokens must carry a "roles" claim containing OPERATOR and/or ANALYST.
JWT_ISSUER_URI=${JWT_ISSUER_URI:-}
INSTITUTION_NAME=${INSTITUTION_NAME:-PaySettle Bank}
